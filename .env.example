# Telegram
BOT_TOKEN=
OWNER_ID=

# HEXIRON SALES central service
CENTRAL_API_URL=https://your-central-bot-app.liara.run
CENTRAL_API_KEY=
PRODUCT_ID=guard
CENTRAL_BOT_USERNAME=

# Optional proxy
PROXY_URL=

# Persistent storage (recommended: mount a Liara disk at /app/data)
DB_PATH=/app/data/guardbot.db
BACKUP_DIR=/app/data/backups
SCREENSHOTS_DIR=/app/data/screenshots

# Payment/card encryption. Generate once and keep the same forever.
CARD_ENCRYPTION_KEY=

# Optional admin PIN / session
ADMIN_PANEL_PIN=
ADMIN_PANEL_SESSION_MINUTES=30

# Moderation
FLOOD_MAX_MESSAGES=6
FLOOD_WINDOW_SECONDS=8
FLOOD_MUTE_MINUTES=10
POINTS_PER_MESSAGE=1

# Optional AI - از طریق AI Gateway لیارا (سازگار با OpenAI)، همون سرویسی که
# پروژه‌ی فروش HEXIRON SALES هم ازش استفاده می‌کنه. از console.liara.ir بخش
# «هوش مصنوعی» یه کلید بساز و baseUrl/apiKey رو از همون‌جا کپی کن.
LIARA_AI_API_KEY=
LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1
AI_CHAT_MODEL=qwen/qwen3.7-flash
AI_FAST_MODEL=qwen/qwen3.7-flash
# اختیاری: اگه مدل اصلی خطای موقت داد (503/provider_unavailable)، این‌ها رو
# به‌ترتیب امتحان می‌کنه. با کاما جدا کن.
AI_FALLBACK_MODELS=
AI_CHAT_RATE_LIMIT_MAX=12
AI_CHAT_RATE_LIMIT_WINDOW=60

# Runtime
LOG_LEVEL=INFO
DEBUG=false
MAX_MESSAGE_TEXT_LENGTH=4096
